{
  "format": 6,
  "revision": 1,
  "id": "rdxc",
  "name": "Russian DX Contest",
  "cabrillo_name": "RDXC",
  "rules_url": "https://rdxc.org/rules_eng",
  "rules_checked": "2026-11",
  "schedule": {"weekend": "full", "nth": 3, "month": 3, "start_hour": 12, "hours": 24},
  "bands": ["160", "80", "40", "20", "15", "10"],
  "modes": ["PH", "CW"],
  "dupe": "band_mode",
  "exchange": [
    {"field": "rst"},
