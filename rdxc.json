  "points": {
    "type": "continent",
    "ru": 10,
    "own_country": 2,
    "same_continent": 3,
    "same_continent_na": 3,
    "other_continent": 5,
    "maritime": 5
  },
  "multipliers": [
    {"type": "ru_oblast", "per": "band"},
    {"type": "country", "per": "band"}
  ],
  "score": "points_x_mults",
  "log_format": "cabrillo",
  "columns": [
    "nr", "utc", "band", "mode", "khz", "call", "rst_s", "ex_s", "rst_r", "ex_r",
    "land", "pts", "gain", "mult"
  ]
