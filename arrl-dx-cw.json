{
  "format": 2,
  "revision": 1,
  "id": "arrl-dx-cw",
  "name": "ARRL International DX CW",
  "cabrillo_name": "ARRL-DX-CW",
  "rules_url": "https://www.arrl.org/arrl-dx",
  "rules_checked": "2026-11",
  "schedule": {"weekend": "full", "nth": 3, "month": 2, "start_hour": 0, "hours": 48},
  "bands": ["160", "80", "40", "20", "15", "10"],
  "modes": ["CW"],
  "dupe": "band",
  "contacts": "w_ve_dx",
  "exchange": [
    {"field": "rst"},
    {
      "field": "location",
      "label": "St/Pwr",
      "by_region": {"us": "state", "ve": "province", "dx": "power"}
    }
  ],
  "points": {"type": "fixed", "value": 3},
  "multipliers": [
    {"type": "us_state", "per": "band", "states": "48dc", "when": "dx"},
    {"type": "ve_province", "per": "band", "when": "dx"},
    {
      "type": "country",
      "per": "band",
      "when": "w_ve",
      "dxcc_only": true,
      "exclude": ["K", "VE"]
    }
  ],
  "score": "points_x_mults",
  "log_format": "cabrillo",
  "columns": [
    "nr", "utc", "band", "khz", "call", "rst_s", "ex_s", "rst_r", "ex_r", "land",
    "pts", "gain", "mult"
  ]
}
